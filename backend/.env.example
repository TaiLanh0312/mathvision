# Sao chép file này thành .env rồi điền khoá thật.
# Lấy khoá tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Mô hình mặc định cho OCR/chấm bài.
GEMINI_MODEL=gemini-3.8-flash
# Hai luồng hình học dùng suy luận mức cao; đổi biến này nếu tài khoản không có quyền truy cập model.
GEMINI_GEOMETRY_MODEL=gemini-3.8-flash
GEMINI_REASONING_MODEL=gemini-3.8-flash
